# ===== Target: Rockchip armv8 / EZPRO Mrkaio M68S PLUS (双 RTL8125B) =====
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_ezpro_mrkaio-m68s-plus=y
# CONFIG_TARGET_MULTI_PROFILE is not set

# ===== 镜像 / 分区 =====
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_TARGZ is not set
CONFIG_TARGET_KERNEL_PARTSIZE=64
CONFIG_TARGET_ROOTFS_PARTSIZE=1024

# ===== 网卡驱动 (DEVICE_PACKAGES 已带，这里显式锁定) =====
CONFIG_PACKAGE_kmod-r8125-rss=y
CONFIG_PACKAGE_kmod-ata-ahci-dwc=y

# ===== firewall4 / nftables 栈 (Nikki 硬依赖) =====
CONFIG_PACKAGE_firewall4=y
# CONFIG_PACKAGE_firewall is not set
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-dummy=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ucode=y

# ===== Nikki (内核选 mihomo-meta 稳定版) =====
CONFIG_PACKAGE_nikki=y
CONFIG_PACKAGE_mihomo-meta=y
# CONFIG_PACKAGE_mihomo-alpha is not set
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=y

# ===== LuCI 基础 =====
CONFIG_PACKAGE_luci=y
# LEDE 默认带 libustream-openssl；luci-ssl 会再拉 libustream-mbedtls，两个变体同时编译会冲突
CONFIG_PACKAGE_luci-ssl-openssl=y
# CONFIG_PACKAGE_luci-ssl is not set
CONFIG_PACKAGE_libustream-openssl=y
# CONFIG_PACKAGE_libustream-mbedtls is not set
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_LUCI_LANG_zh_Hans=y

# ===== 去掉与 Nikki 冲突/重复的代理插件 =====
# CONFIG_PACKAGE_luci-app-ssr-plus is not set
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-app-openclash is not set

# ===== 常用工具 =====
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_ethtool=y
